# 本機整合測試用環境變數。
# 使用方式：cp .env.test.example .env.test
# 由 ./test.sh 與 pre-push hook 載入。
# 只能指向 danmaku_test 資料庫與 Redis db 15，絕不能指向開發用的 danmaku DB。
# 以下為本機 docker-compose 的值。
TEST_DATABASE_URL='postgres://danmaku:danmaku@localhost:3192/danmaku_test?sslmode=disable'
TEST_REDIS_URL='redis://localhost:2907/15'
